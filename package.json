{
  "name": "mc-schema-mcp",
  "version": "0.1.0",
  "description": "MCP server for designing Minecraft builds and exporting them as Sponge Schematic (.schem) files.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run && pnpm run typecheck:test",
    "test:perf": "node --expose-gc ./node_modules/vitest/vitest.mjs run --config vitest.perf.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@enginehub/nbt-ts": "^1.4.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fflate": "^0.8.3",
    "three": "^0.187.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@enginehub/schematicjs": "^0.10.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.187.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
